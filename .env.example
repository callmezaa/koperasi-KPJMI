# Supabase — salin file ini menjadi .env.local lalu isi dari
# Project Settings → API di dashboard Supabase Anda.
# Kedua variabel VITE_ aman untuk diekspos ke browser (dilindungi RLS).

VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Hanya untuk script seed lokal (scripts/seed-supabase.mjs) — JANGAN pernah
# di-commit dan JANGAN beri awalan VITE_ (service key tidak boleh ke browser).
SUPABASE_SERVICE_ROLE_KEY=

# Opsional — untuk membuat akun admin lewat script seed.
# Email + password ini Anda tentukan sendiri (bukan dari Supabase).
ADMIN_EMAIL=
ADMIN_PASSWORD=
